# ==============================================================================
# Investment Research Swarm - Environment Configuration
# ==============================================================================

# LLM Configuration (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Alternative Groq models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, deepseek-r1-distill-llama-70b

# Web Search API (Tavily)
TAVILY_API_KEY=tvly_your_tavily_api_key_here

# SEC EDGAR API User-Agent (Required by SEC: Name and Email)
# Example: "MyInvestmentFirm analyst@myfirm.com"
SEC_USER_AGENT=InvestmentResearchSwarm analyst@swarmresearch.io

# Database Configuration (MySQL)
# For local MySQL: mysql+pymysql://root:password@localhost:3306/investment_swarm
# If left empty, system gracefully defaults to sqlite:///./investment_swarm.db for zero-config local testing
MYSQL_URL=mysql+pymysql://root:password@localhost:3306/investment_swarm

# Observability (LangSmith - Optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=investment-research-swarm

# Application Settings
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
